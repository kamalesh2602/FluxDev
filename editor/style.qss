
/* ==========================================================================
   FLUXDEV DESIGN SYSTEM — STRICT QT-COMPLIANT STYLESHEET
   ========================================================================== */

* {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* Frameless Window Root Container */
#root-container {
    background-color: #0B0D14;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
}

QWidget {
    background-color: transparent;
    color: #F8FAFC;
    font-size: 13px;
}

/* Custom Title Bar */
#title-bar {
    background-color: #0B0D14;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    min-height: 42px;
    max-height: 42px;
    padding-left: 12px;
    padding-right: 12px;
}

/* Window Control Buttons (Minimal Dots) */
#btn-win-close {
    background-color: #EF4444;
    min-width: 13px;
    max-width: 13px;
    min-height: 13px;
    max-height: 13px;
    border-radius: 6px;
    border: none;
}
#btn-win-close:hover {
    background-color: #DC2626;
}

#btn-win-min {
    background-color: #F59E0B;
    min-width: 13px;
    max-width: 13px;
    min-height: 13px;
    max-height: 13px;
    border-radius: 6px;
    border: none;
}
#btn-win-min:hover {
    background-color: #D97706;
}

#btn-win-max {
    background-color: #10B981;
    min-width: 13px;
    max-width: 13px;
    min-height: 13px;
    max-height: 13px;
    border-radius: 6px;
    border: none;
}
#btn-win-max:hover {
    background-color: #059669;
}

/* Command Palette Search Trigger */
#btn-cmd-palette-trigger {
    background-color: #121626;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    color: #94A3B8;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 500;
}
#btn-cmd-palette-trigger:hover {
    background-color: #161B30;
    border-color: #8B5CF6;
    color: #F8FAFC;
}

/* Pill Tabs */
QTabWidget::pane {
    border: none;
    background-color: #0B0D14;
}

QTabBar {
    background-color: #0B0D14;
    border: none;
    padding: 4px 8px;
}

QTabBar::tab {
    background-color: transparent;
    color: #94A3B8;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 6px 14px;
    margin-right: 4px;
    font-size: 12px;
    font-weight: 500;
    min-width: 90px;
}

QTabBar::tab:hover:!selected {
    background-color: #121626;
    color: #F8FAFC;
}

QTabBar::tab:selected {
    background-color: #1E2542;
    color: #F8FAFC;
    border: 1px solid rgba(139, 92, 246, 0.5);
    border-bottom: 2px solid #8B5CF6;
    font-weight: bold;
}

QTabBar::close-button {
    subcontrol-position: right;
    margin-left: 8px;
    padding: 2px;
    border-radius: 4px;
}
QTabBar::close-button:hover {
    background-color: rgba(239, 68, 68, 0.7);
    color: #FFFFFF;
}

/* Sidebar (Project Explorer Glass Panel) */
#sidebar-panel {
    background-color: #121626;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
}

QTreeView {
    background-color: transparent;
    color: #F8FAFC;
    border: none;
    font-size: 13px;
}

QTreeView::item {
    padding: 5px 8px;
    border-radius: 6px;
    margin: 1px 4px;
}

QTreeView::item:hover {
    background-color: #1D233D;
}

QTreeView::item:selected {
    background-color: #1E2542;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.08);
}

/* Live Preview Toolbar (Fixed 38px) */
#preview-header {
    background-color: #121626;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    min-height: 38px;
    max-height: 38px;
    padding: 0 10px;
}

/* Status Bar */
QStatusBar {
    background-color: #0B0D14;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: #94A3B8;
    font-size: 11px;
    min-height: 26px;
    max-height: 26px;
    padding: 0 10px;
}

QStatusBar QLabel {
    color: #94A3B8;
    padding: 0 8px;
}

/* Modern Glass Buttons */
QPushButton {
    background-color: #121626;
    color: #F8FAFC;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #1D233D;
    border-color: #8B5CF6;
}

QPushButton:pressed {
    background-color: #1E2542;
}

/* Primary Accent Gradient Button */
QPushButton.btn-primary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8B5CF6, stop:1 #06B6D4);
    color: #FFFFFF;
    font-weight: bold;
    border: none;
}
QPushButton.btn-primary:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8B5CF6, stop:1 #06B6D4);
}

/* Inputs */
QLineEdit {
    background-color: #181D33;
    color: #F8FAFC;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 6px 12px;
}

QLineEdit:focus {
    border: 1px solid #8B5CF6;
}

QCheckBox {
    color: #94A3B8;
    spacing: 6px;
}

/* Slim 6px Custom Scrollbars */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.12);
    min-height: 24px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(139, 92, 246, 0.6);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.12);
    min-width: 24px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(139, 92, 246, 0.6);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* 1px Splitter Handles with Hover Highlight (Issue 8) */
QSplitter::handle {
    background-color: rgba(255, 255, 255, 0.08);
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QSplitter::handle:hover {
    background-color: #8B5CF6;
}
